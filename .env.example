# Copy to .env.local and fill in values. Never commit .env.local.

# Browser-safe public configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Server-only credentials (never prefix these with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# 32+ random characters used to bind checkout data to an HttpOnly browser session.
CHECKOUT_SESSION_SECRET=replace_with_a_long_random_value
